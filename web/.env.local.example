# Coach Spilo — Environment variables
#
# Copy this file to .env.local for local dev. Production values go in
# Vercel → Project Settings → Environment Variables.
#
# ANY oauth provider whose CLIENT_ID is left unset will fall back to a
# mocked OAuth flow that auto-succeeds — useful for local development
# before real credentials are available.

# ─────────────────────────────────────────────────────────────────────
# Twitch — sub-status verification for Twitch subscriber discount
# Register at https://dev.twitch.tv/console/apps
# Add redirect URI: ${SITE_URL}/api/auth/twitch/callback
# Required scope: user:read:subscriptions
# ─────────────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Spilo's Twitch broadcaster user ID (numeric, NOT username).
# Look up with: curl -H "Client-Id: $TWITCH_CLIENT_ID" -H "Authorization: Bearer $APP_TOKEN" \
#                    "https://api.twitch.tv/helix/users?login=spilo"
TWITCH_CHANNEL_ID=

# ─────────────────────────────────────────────────────────────────────
# Patreon — membership verification for Patreon patron discount
# Register at https://www.patreon.com/portal/registration/register-clients
# Add redirect URI: ${SITE_URL}/api/auth/patreon/callback
# Required scopes: identity identity.memberships
# ─────────────────────────────────────────────────────────────────────
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
# Spilo's Patreon campaign ID. Visible in the campaign URL or via API.
PATREON_CAMPAIGN_ID=

# ─────────────────────────────────────────────────────────────────────
# Session cookie signing — REQUIRED in production
# Generate with: openssl rand -base64 48
# Must be 32+ characters.
# ─────────────────────────────────────────────────────────────────────
SESSION_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Site URL — optional. Auto-detected from VERCEL_PROJECT_PRODUCTION_URL
# on Vercel, falls back to localhost in dev. Set this once a custom
# domain (e.g. coachspilo.com) is live.
# ─────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://coachspilo.com
